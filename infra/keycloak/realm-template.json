{
  "realm": "__REALM__",
  "enabled": true,
  "displayName": "__DISPLAY__",
  "loginWithEmailAllowed": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "maxDeltaTimeSeconds": 43200,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "passwordPolicy": "length(10) and upperCase(1) and digits(1) and notUsername",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "roles": {
    "realm": [
      { "name": "platform-admin", "description": "Install-wide operator: notification channels and backups; give it only to the operator (see PLATFORM_ADMIN_REALMS)" },
      { "name": "admin", "description": "Operations manager: sites, schedules, guards, devices, reports, system settings" },
      { "name": "supervisor", "description": "Shift supervisor: team status, SOS, incidents, attendance review" },
      { "name": "hr", "description": "HR / payroll: attendance and monthly recap (read-only)" },
      { "name": "client-readonly", "description": "Client / site owner: read-only reports and live patrol status" },
      { "name": "device", "description": "Shared site tablet account (one per tablet); never assign to people" }
    ]
  },
  "clients": [
    {
      "clientId": "securepatrol-web",
      "name": "SecurePatrol Web",
      "description": "Public OIDC client for the web dashboard (authorization code + PKCE)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "rootUrl": "",
      "baseUrl": "/",
      "redirectUris": [
        "https://localhost/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "realm roles (flat)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "securepatrol-tablet",
      "name": "SecurePatrol Tablet",
      "description": "Public client for shared site tablets (device accounts, password grant + offline token)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "realm roles (flat)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "scopeMappings": [
    { "client": "securepatrol-web", "roles": ["platform-admin", "admin", "supervisor", "hr", "client-readonly"] },
    { "client": "securepatrol-tablet", "roles": ["device"] }
  ],
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "enabledEventTypes": [
    "LOGIN", "LOGIN_ERROR", "LOGOUT", "CODE_TO_TOKEN", "CODE_TO_TOKEN_ERROR",
    "REFRESH_TOKEN_ERROR", "RESET_PASSWORD", "UPDATE_PASSWORD", "UPDATE_TOTP", "REMOVE_TOTP"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true
}
