{
  "realm": "securepatrol-client1",
  "enabled": true,
  "displayName": "SecurePatrol",
  "displayNameHtml": "<strong>SecurePatrol</strong>",
  "loginWithEmailAllowed": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "maxDeltaTimeSeconds": 43200,
  "accessTokenLifespan": 900,
  "ssoSessionMaxLifespan": 28800,
  "ssoSessionIdleTimeout": 1800,
  "offlineSessionMaxLifespan": 5184000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "passwordPolicy": "length(8) and upperCase(1) and digits(1)",
  "sslRequired": "external",
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Full system administrator — can manage all tenants, users, and configuration",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "supervisor",
        "description": "Patrol supervisor — can view and manage guard assignments and incidents",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "guard",
        "description": "Security guard — can log checkpoints, incidents, and view own schedule",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "hr",
        "description": "HR personnel — can manage guard profiles, contracts, and payroll data",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "client-readonly",
        "description": "Client (site owner) — read-only access to reports and live patrol status for their site",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "groups": [],
  "clients": [
    {
      "clientId": "securepatrol-web",
      "name": "SecurePatrol Web App",
      "description": "Public OIDC client for the React SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "https://localhost/*",
        "https://*.securepatrol.local/*"
      ],
      "webOrigins": ["+"],
      "rootUrl": "",
      "baseUrl": "",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "securepatrol-api",
      "name": "SecurePatrol API",
      "description": "Bearer-only client for the Go backend — never issues tokens, only validates them",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": []
    }
  ],
  "clientScopes": [
    {
      "name": "roles",
      "description": "Realm roles mapped into the token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "identityProviders": [],
  "userFederationProviders": [],
  "userFederationMappers": [],
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "REGISTER",
    "RESET_PASSWORD",
    "UPDATE_PASSWORD",
    "UPDATE_EMAIL",
    "SEND_RESET_PASSWORD",
    "CLIENT_LOGIN",
    "CODE_TO_TOKEN",
    "CODE_TO_TOKEN_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true
}
