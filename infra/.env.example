# =============================================================================
# SecurePatrol Infrastructure Environment Variables
# Copy this file to .env and fill in real values before running `make up`
# Never commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=securepatrol
POSTGRES_USER=securepatrol
POSTGRES_PASSWORD=change_me_postgres_password

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change_me_redis_password

# -----------------------------------------------------------------------------
# MinIO Object Storage
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password

# Bucket names (created by the API on first start)
MINIO_BUCKET_PHOTOS=securepatrol-photos
MINIO_BUCKET_BACKUPS=securepatrol-backups

# -----------------------------------------------------------------------------
# Keycloak Identity Provider
# -----------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_password

# Keycloak database connection (points at the postgres service)
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/securepatrol
KC_DB_USERNAME=securepatrol
KC_DB_PASSWORD=change_me_postgres_password

# Public hostname Keycloak uses in token issuer URLs
# For local dev: localhost  |  For prod: auth.yourdomain.com
KC_HOSTNAME=localhost

# -----------------------------------------------------------------------------
# API / Backend
# -----------------------------------------------------------------------------
API_PORT=8080

# JWKS endpoint for the securepatrol-client1 realm
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/securepatrol-client1/protocol/openid-connect/certs

# Token issuer — must match the iss claim in JWTs
KEYCLOAK_ISSUER=http://localhost/auth/realms/securepatrol-client1

# Logging verbosity: debug | info | warn | error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# SMTP (Notification Worker)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=change_me_smtp_password
SMTP_FROM=SecurePatrol <notifications@example.com>

# -----------------------------------------------------------------------------
# WhatsApp Business API (Notification Worker)
# -----------------------------------------------------------------------------
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_TOKEN=change_me_whatsapp_token

# -----------------------------------------------------------------------------
# Build / Release
# -----------------------------------------------------------------------------
# Git tag or semver injected at build time
VERSION=dev

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
GF_SECURITY_ADMIN_PASSWORD=change_me_grafana_password
