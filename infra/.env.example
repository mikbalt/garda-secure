# =============================================================================
# SecurePatrol — environment for infra/docker-compose*.yml
# Copy to infra/.env and change every "change_me" value. Never commit .env.
# =============================================================================

# Public base URL users open in the browser (nginx, TLS). Use the server's
# LAN name/IP in production, e.g. https://patrol.example.co.id
PUBLIC_URL=https://localhost

# Server time zone; the daily backup runs at BACKUP_HOUR in this zone.
TZ=Asia/Jakarta
BACKUP_HOUR=2

# -----------------------------------------------------------------------------
# PostgreSQL (app database; Keycloak gets its own database KC_DB_NAME)
# -----------------------------------------------------------------------------
POSTGRES_DB=securepatrol
POSTGRES_USER=securepatrol
POSTGRES_PASSWORD=change_me_postgres_password
KC_DB_NAME=keycloak

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change_me_redis_password

# -----------------------------------------------------------------------------
# MinIO object storage (photos, backups)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=securepatrol
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BUCKET_PHOTOS=securepatrol-photos
MINIO_BUCKET_BACKUPS=securepatrol-backups
# host:port browsers use for pre-signed photo links (nginx TLS port 9443).
MINIO_PUBLIC_ENDPOINT=localhost:9443
MINIO_PUBLIC_USE_SSL=true

# -----------------------------------------------------------------------------
# Keycloak (one realm per client company — DECISIONS.md D-005)
# -----------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_password
# Public Keycloak base URL = token issuer prefix. Must be ${PUBLIC_URL}/auth.
# Infra-only local dev (no nginx TLS): http://localhost:8081/auth
KEYCLOAK_PUBLIC_URL=https://localhost/auth
# Realms the API trusts (comma-separated). Files live in infra/keycloak/realms.
KEYCLOAK_REALMS=securepatrol-client1,securepatrol-client2
# Realms offered on the web login screen: realm:Label pairs.
WEB_KEYCLOAK_REALMS=securepatrol-client1:Client 1,securepatrol-client2:Client 2

# -----------------------------------------------------------------------------
# API / worker
# -----------------------------------------------------------------------------
# 32+ random characters; encrypts SMTP/WhatsApp secrets saved from the web UI.
# Changing it later makes saved secrets unreadable (re-enter them).
#   openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=change_me_long_random_string
# Only needed when the web app is served from another origin (e.g. Vite dev).
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info
VERSION=dev

# -----------------------------------------------------------------------------
# Notification channel defaults (admins can override these in Settings → Channels)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SecurePatrol <notifications@example.com>

# WhatsApp Business Cloud API. Business-initiated messages require an approved
# template with ONE body parameter, e.g. "SecurePatrol: {{1}}".
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=id

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
GF_SECURITY_ADMIN_PASSWORD=change_me_grafana_password
