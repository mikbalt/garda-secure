# Secrets — never commit these
.env
*.env.local
*.pem
*.key
*.crt
infra/nginx/certs/
*.jks
*.keystore
mobile/android/key.properties
# Operational state on the server (pre-deploy dumps, deploy history)
infra/backups/
infra/.deploy/

# Go
backend/vendor/
backend/tmp/
backend/*.test
backend/coverage.out

# Node / React
web/node_modules/
web/dist/
web/.vite/

# Flutter
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
# mobile/pubspec.lock IS committed: the app's dependency versions must be
# reproducible (INF-C6).

# Docker
**/*.tar
**/docker-compose.override.yml

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Build artifacts
*.o
*.a
*.so
dist/
build/
