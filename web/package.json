    "keycloak-js": "26.2.4",
    "lucide-react": "0.577.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.90.0",
    "react-router-dom": "7.18.4",
    "recharts": "2.12.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
