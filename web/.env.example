# Development settings for `npm run dev` (copy to .env.local).
# In Docker these are replaced at runtime by /config.js (API_URL, KEYCLOAK_URL,
# KEYCLOAK_CLIENT_ID, KEYCLOAK_REALMS on the web container).

# API base URL — already includes /api/v1 (Vite proxies /api to localhost:8080).
VITE_API_URL=/api/v1

# Keycloak base URL (Vite proxies /auth to localhost:8081), or e.g. http://localhost:8081
VITE_KEYCLOAK_URL=/auth
VITE_KEYCLOAK_CLIENT_ID=securepatrol-web

# One realm per client company: "realm-id:Label" pairs, comma separated.
# With more than one realm the app shows a "choose organisation" screen.
VITE_KEYCLOAK_REALMS=securepatrol-client1:Client 1,securepatrol-client2:Client 2
