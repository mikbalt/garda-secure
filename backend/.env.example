# Backend local development (go run ./cmd/securepatrol) against
# `docker compose up -d` in infra/ (infra-only mode). Load with your shell or
# an env loader; the binary reads plain environment variables.
#
# For infra-only dev set KEYCLOAK_PUBLIC_URL=http://localhost:8081/auth in
# infra/.env too, so Keycloak issues tokens with the same issuer.

DATABASE_URL=postgres://securepatrol:change_me_postgres_password@localhost:5432/securepatrol?sslmode=disable
REDIS_URL=redis://:change_me_redis_password@localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_USE_SSL=false
MINIO_ACCESS_KEY=securepatrol
MINIO_SECRET_KEY=change_me_minio_password
MINIO_BUCKET_PHOTOS=securepatrol-photos
MINIO_BUCKET_BACKUPS=securepatrol-backups

KEYCLOAK_URL=http://localhost:8081/auth
KEYCLOAK_PUBLIC_URL=http://localhost:8081/auth
KEYCLOAK_REALMS=securepatrol-client1,securepatrol-client2

# Vite dev server origin
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
SETTINGS_ENCRYPTION_KEY=dev-only-not-secret

BACKUP_HOUR=2
MIGRATIONS_PATH=./migrations
LOG_LEVEL=debug
PORT=8080
